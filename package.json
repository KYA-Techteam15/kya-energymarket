{
  "name": "kya-energy-market",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "KYA-EnergyMarket — la marketplace des logiciels de KYA-Energy Group",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @kya-em/web dev",
    "build": "pnpm --filter @kya-em/web build",
    "start": "pnpm --filter @kya-em/web start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "e2e": "pnpm --filter @kya-em/web e2e",
    "secrets:scan": "secretlint --maskSecrets \"**/*\"",
    "tokens": "tsx scripts/tokens.ts",
    "env:link": "node scripts/env-link.mjs",
    "neon:setup": "node scripts/neon-setup.mjs",
    "db:generate": "pnpm --filter @kya-em/db generate",
    "db:migrate": "pnpm --filter @kya-em/db migrate",
    "check:branch": "node scripts/check-branch.mjs",
    "staff:grant": "tsx scripts/staff-grant.ts",
    "auth:schema": "auth generate --config packages/auth/schema.config.ts --output packages/db/src/schema/auth.ts --yes",
    "coolify:deploy": "node scripts/coolify-deploy.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm build && pnpm typecheck && pnpm e2e && pnpm secrets:scan",
    "db:seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "@types/node": "^22.18.6",
    "auth": "1.7.6",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "secretlint": "^13.0.6",
    "tsx": "^4.20.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
