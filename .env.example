# KYA-EnergyMarket — noms des variables, SANS valeurs. Ne jamais remplir ce fichier.
# Les valeurs vivent hors du dépôt : docs/operations/secrets-et-environnements.md

# Application
APP_ENV=
APP_BASE_URL=

# Neon (organisation KYA)
NEON_API_KEY=
NEON_ORG_ID=
NEON_PROJECT_ID=
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Branche Neon « test » : base des tests de parcours en local
DATABASE_TEST_URL=
DATABASE_TEST_MIGRATION_URL=

# Comptes et OAuth (MCP)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Secrets des sessions des environnements déployés (générés par pnpm coolify:deploy)
BETTER_AUTH_SECRET_DEV=
BETTER_AUTH_SECRET_PRODUCTION=

# Paiement Semoa Afrique
SEMOA_API_URL=
SEMOA_CLIENT_ID=
SEMOA_CLIENT_SECRET=
SEMOA_WEBHOOK_SECRET=

# Licences des logiciels (clé privée ECDSA P-256, JWK sur une ligne ; par environnement dans le
# fichier de secrets : LICENSE_SIGNING_PRIVATE_KEY_DEV…, créées par pnpm license:keygen)
LICENSE_SIGNING_KEY_ID=
LICENSE_SIGNING_PRIVATE_KEY=

# Courriel transactionnel (SMTP, tout ou rien ; port 465 = TLS direct, sinon STARTTLS)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Médias : Neon Object Storage (tout ou rien). En ligne, par environnement dans le fichier de secrets
# (MEDIA_BUCKET_DEV, AWS_ACCESS_KEY_ID_DEV…), recopiés par pnpm coolify:deploy. Sans eux : MEDIA_DIR.
MEDIA_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
MEDIA_DIR=


# Déploiement Coolify
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_PROJECT_UUID=
COOLIFY_SERVER_UUID=
